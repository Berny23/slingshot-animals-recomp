// SPDX-License-Identifier: GPL-3.0-or-later
// Windows resources of a game's executable (games/CMakeLists.txt).
#include <winver.h>

1 ICON "@GAME_ICON@"
1 24 "@GAME_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @GAME_VERSION_COMMAS@
PRODUCTVERSION @GAME_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@GAME_TITLE@"
            VALUE "ProductName", "@GAME_TITLE@"
            VALUE "ProductVersion", "@GAME_VERSION@"
            VALUE "FileVersion", "@GAME_VERSION@"
            VALUE "OriginalFilename", "slingshot-@GAME_ID@.exe"
            VALUE "Comments", "slingshot-animals-recomp"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
