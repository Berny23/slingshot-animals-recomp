{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Slingshot Animals Recomp",
  "repo": "Berny23/slingshot-animals-recomp",
  "inputs": [
    {
      "id": "apk-classic",
      "label": "Your Angry Birds Classic APK: version 8.0.3 (build 8031), package com.rovio.angrybirds, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "apk-seasons",
      "label": "Your Angry Birds Seasons APK: version 6.6.2 (build 6620), package com.rovio.angrybirdsseasons, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "apk-rio",
      "label": "Your Angry Birds Rio APK: version 2.6.13 (build 2676), package com.rovio.angrybirdsrio, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "apk-space",
      "label": "Your Angry Birds Space HD APK: version 2.2.14 (build 221400), package com.rovio.angrybirdsspaceHD, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "apk-starwars",
      "label": "Your Angry Birds Star Wars HD APK: version 1.5.13 (build 151300), package com.rovio.angrybirdsstarwarshd.premium.iap, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "apk-starwars2",
      "label": "Your Angry Birds Star Wars II APK: version 1.9.25 (build 192500), package com.rovio.angrybirdsstarwarsii.ads, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "apk-stella",
      "label": "Your Angry Birds Stella APK: version 1.1.5 (build 1152), package com.rovio.angrybirdsstella, with the armeabi-v7a library.",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "apk"
          ]
        }
      ]
    },
    {
      "id": "starwars2-assets",
      "label": "Star Wars II sounds and theme images (optional): files/assets_service/ from an installation on an Android device, as a ZIP or folder. Without them the game has no music and draws placeholder backgrounds.",
      "role": "dlc",
      "optional": true,
      "formats": [
        {
          "type": "file",
          "extensions": [
            "zip"
          ]
        },
        {
          "type": "folder"
        }
      ]
    }
  ],
  "start": {
    "program": [
      "Slingshot Builder.app",
      "slingshot-builder.exe",
      "slingshot-builder-x86_64.AppImage",
      "AppRun"
    ],
    "args": [
      "--data={data}"
    ]
  },
  "prepare": {
    "program": [
      "Slingshot Builder.app",
      "slingshot-builder.exe",
      "slingshot-builder-x86_64.AppImage",
      "AppRun"
    ],
    "args": [
      "--prepare",
      "--data={data}",
      "--apk={input:apk-classic}",
      "--apk={input:apk-seasons}",
      "--apk={input:apk-rio}",
      "--apk={input:apk-space}",
      "--apk={input:apk-starwars}",
      "--apk={input:apk-starwars2}",
      "--apk={input:apk-stella}",
      "--starwars2-assets={input:starwars2-assets}"
    ],
    "label": "Building the game from your APK. The first build takes a while.",
    "done": [
      "{data}/games/prepared.txt"
    ]
  },
  "saves": [
    "{data}/saves"
  ],
  "games": [
    {
      "id": "classic",
      "name": "Angry Birds Classic",
      "args": [
        "--play=classic"
      ],
      "inputs": [
        "apk-classic"
      ],
      "saves": [
        "{data}/saves/classic"
      ]
    },
    {
      "id": "seasons",
      "name": "Angry Birds Seasons",
      "args": [
        "--play=seasons"
      ],
      "inputs": [
        "apk-seasons"
      ],
      "saves": [
        "{data}/saves/seasons"
      ]
    },
    {
      "id": "rio",
      "name": "Angry Birds Rio",
      "args": [
        "--play=rio"
      ],
      "inputs": [
        "apk-rio"
      ],
      "saves": [
        "{data}/saves/rio"
      ]
    },
    {
      "id": "space",
      "name": "Angry Birds Space HD",
      "args": [
        "--play=space"
      ],
      "inputs": [
        "apk-space"
      ],
      "saves": [
        "{data}/saves/space"
      ]
    },
    {
      "id": "starwars",
      "name": "Angry Birds Star Wars HD",
      "args": [
        "--play=starwars"
      ],
      "inputs": [
        "apk-starwars"
      ],
      "saves": [
        "{data}/saves/starwars"
      ]
    },
    {
      "id": "starwars2",
      "name": "Angry Birds Star Wars II",
      "args": [
        "--play=starwars2"
      ],
      "inputs": [
        "apk-starwars2",
        "starwars2-assets"
      ],
      "saves": [
        "{data}/saves/starwars2"
      ]
    },
    {
      "id": "stella",
      "name": "Angry Birds Stella",
      "args": [
        "--play=stella"
      ],
      "inputs": [
        "apk-stella"
      ],
      "saves": [
        "{data}/saves/stella"
      ]
    }
  ],
  "settings": [
    {
      "id": "fullscreen",
      "label": "Start in",
      "group": "Display",
      "in": "args",
      "help": "F11 switches between window and fullscreen while playing.",
      "choices": [
        {
          "label": "Window",
          "args": []
        },
        {
          "label": "Fullscreen",
          "args": [
            "--mod-option",
            "fullscreen.start=1"
          ]
        }
      ]
    },
    {
      "id": "aspect",
      "label": "Fullscreen shape",
      "group": "Display",
      "in": "args",
      "help": "16:9 keeps the game's shape on ultrawide screens, with black bars at the sides.",
      "choices": [
        {
          "label": "Fill the screen",
          "args": []
        },
        {
          "label": "16:9",
          "args": [
            "--mod-option",
            "fullscreen.aspect=16:9"
          ]
        }
      ]
    },
    {
      "id": "mod-mouse-wheel",
      "label": "Mouse wheel",
      "group": "Mods",
      "in": "args",
      "help": "Zooms in levels and scrolls menus.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "mouse-wheel"
          ]
        }
      ]
    },
    {
      "id": "mod-keyboard",
      "label": "Keyboard play",
      "group": "Mods",
      "in": "args",
      "help": "Space to aim and shoot, W A S D or arrows to aim, R restarts, P pauses.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "keyboard"
          ]
        }
      ]
    },
    {
      "id": "mod-gamepad-pointer",
      "label": "Gamepad play",
      "group": "Mods",
      "in": "args",
      "help": "The left stick moves a cursor, A taps, triggers zoom, B is Back.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "gamepad-pointer"
          ]
        }
      ]
    },
    {
      "id": "mod-tap-to-skip",
      "label": "Tap to skip",
      "group": "Mods",
      "in": "args",
      "help": "Skips the wait at the end of a level.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "tap-to-skip"
          ]
        }
      ]
    },
    {
      "id": "mod-fullscreen",
      "label": "Fullscreen",
      "group": "Mods",
      "in": "args",
      "help": "F11 and the display settings above.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "fullscreen"
          ]
        }
      ]
    },
    {
      "id": "mod-phone-scale",
      "label": "Phone scale",
      "group": "Mods",
      "in": "args",
      "help": "On phones, menus and buttons as large as in the other games. Only in Star Wars.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "phone-scale"
          ]
        }
      ]
    },
    {
      "id": "mod-hide-dead-services",
      "label": "Hide dead services",
      "group": "Mods",
      "in": "args",
      "help": "Hides buttons and messages of online services that are gone.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "hide-dead-services"
          ]
        }
      ]
    },
    {
      "id": "mod-offline-shop",
      "label": "Offline shop",
      "group": "Mods",
      "in": "args",
      "help": "Everything once sold for real money can be earned by playing.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "offline-shop"
          ]
        }
      ]
    },
    {
      "id": "mod-game-statistics",
      "label": "Statistics page",
      "group": "Mods",
      "in": "args",
      "help": "Statistics, achievements and progress to 100 %, also for RecompLauncher achievements.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "game-statistics"
          ]
        }
      ]
    },
    {
      "id": "mod-offline-league",
      "label": "Offline Mighty League",
      "group": "Mods",
      "in": "args",
      "help": "Mighty League without servers. Only in Classic.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "offline-league"
          ]
        }
      ]
    },
    {
      "id": "mod-offline-tournament",
      "label": "Offline Pig Challenge",
      "group": "Mods",
      "in": "args",
      "help": "Pig Challenge without servers: weeks open one after another. Only in Seasons.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "offline-tournament"
          ]
        }
      ]
    },
    {
      "id": "mod-composite-audio",
      "label": "Menu music",
      "group": "Mods",
      "in": "args",
      "help": "Plays the menu music and power-up sounds again. Only in Star Wars, Star Wars II.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "composite-audio"
          ]
        }
      ]
    },
    {
      "id": "mod-offline-assets",
      "label": "Start without server",
      "group": "Mods",
      "in": "args",
      "help": "Starts without the download server that is gone. Only in Star Wars II.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "offline-assets"
          ]
        }
      ]
    },
    {
      "id": "mod-audio-quality",
      "label": "Better sound",
      "group": "Mods",
      "in": "args",
      "help": "Stereo sound at 24 kHz, better than on Android. Only in Stella.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "audio-quality"
          ]
        }
      ]
    },
    {
      "id": "mod-seasonal-menu",
      "label": "Seasonal menu",
      "group": "Mods",
      "in": "args",
      "help": "Before an episode is played, the main menu shows an episode of the current season instead of Ragnahog. Only in Seasons.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "seasonal-menu"
          ]
        }
      ]
    },
    {
      "id": "mod-offline-clock",
      "label": "Offline clock",
      "group": "Mods",
      "in": "args",
      "help": "Timed features use the PC's clock. Only in Star Wars II.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "offline-clock"
          ]
        }
      ]
    },
    {
      "id": "mod-missing-translations",
      "label": "Missing translations",
      "group": "Mods",
      "in": "args",
      "help": "Translates texts the game shows only in English. Only in Rio.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "missing-translations"
          ]
        }
      ]
    },
    {
      "id": "mod-samsung-level",
      "label": "Samsung content",
      "group": "Mods",
      "in": "args",
      "help": "Content once only on Samsung devices is open everywhere. Only in Space, Star Wars II.",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--no-mod",
            "samsung-level"
          ]
        }
      ]
    }
  ],
  "folders": {
    "logs": [
      {
        "path": "{data}/logs"
      }
    ]
  },
  "exit_codes": {
    "3": "This game isn't built yet. Set it up again on its page."
  },
  "looks": {
    "allowed": false,
    "reason": "The game is built on your PC into its own folder, so looks can't be added to it."
  },
  "system": {
    "windows": {
      "version": "10"
    },
    "linux": {
      "glibc": "2.35"
    }
  }
}
